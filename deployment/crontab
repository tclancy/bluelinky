# Fuel Monitor Cron Schedule
# Runs every hour at the top of the hour
# Logs to /var/log/fuel-monitor/cron.log

PATH=/usr/local/bin:/usr/bin:/bin

# Run combined vehicle monitor: fuel + TPMS + SQLite history
0 * * * * cd /app && npx tsx monitor.ts >> /var/log/fuel-monitor/cron.log 2>&1

# Keep a newline at the end for cron to work properly
